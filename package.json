{
  "name": "dsh-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop shell and local plugin workbench for DeepSeek Harness",
  "author": "ParkerLille and contributors",
  "license": "MIT",
  "homepage": "https://github.com/ParkerLille/dsh-desktop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ParkerLille/dsh-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/ParkerLille/dsh-desktop/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "electron",
    "desktop",
    "ai-agent"
  ],
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "repair:session": "node scripts/repair-session-log.ts",
    "typecheck": "tsc --noEmit",
    "build": "electron-vite build",
    "dist:win": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/dist-win.ps1"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.0-rc.6",
    "@deepseek-ai/dsh-atomic-write": "0.1.0-rc.6",
    "@deepseek-ai/dsh-code-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-compaction": "0.1.0-rc.6",
    "@deepseek-ai/dsh-fs": "0.1.0-rc.6",
    "@deepseek-ai/dsh-output-retention": "0.1.0-rc.6",
    "@deepseek-ai/dsh-sandbox": "0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-telemetry": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-title-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-shell": "0.1.0-rc.6",
    "@deepseek-ai/dsh-spill": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.6",
    "@deepseek-ai/dsh-timeout": "0.1.0-rc.6",
    "@deepseek-ai/dsh-workflow": "0.1.0-rc.6",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "optionalDependencies": {
    "@img/sharp-win32-x64": "0.35.3",
    "@koromix/koffi-win32-x64": "3.1.5",
    "@vscode/ripgrep-win32-x64": "1.18.0",
    "node-addon-require-builtin-win32-x64-msvc": "0.1.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "ai.deepseek.dsh.desktop",
    "productName": "DeepSeek Harness Desktop",
    "directories": {
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "asar": false,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
